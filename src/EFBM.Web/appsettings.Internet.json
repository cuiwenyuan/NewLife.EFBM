{
  // 外网部署：ASPNETCORE_ENVIRONMENT=Internet。
  // 强制 HTTPS、禁用业务匿名认证、只暴露 POST /api/events 与后台入口；Redis 仅内网 / VPC 可达。
  // 启动自检：缺 HTTPS 或启用 Anonymous 会直接失败（EfbmOptions.ValidateOrThrow）。
  "ConnectionStrings": {
    "EFBM": "Server=10.0.0.10;Port=3306;Database=EFBM;Uid=efbm;Pwd=<替换为强密码>;Provider=MySql",
    "Membership": "Server=10.0.0.10;Port=3306;Database=Membership;Uid=efbm;Pwd=<替换为强密码>;Provider=MySql"
  },
  "EFBM": {
    "Deployment": "Internet",
    "RequireHttps": true,
    "AuthMode": "AppKeyAppSecret",
    "AppKeyHeader": "X-App-Key",
    "AppSecretHeader": "X-App-Secret",
    "RedisServer": "10.0.0.20:6379",
    // 外网前置 Nginx 必须透传 X-Forwarded-Proto / X-Forwarded-For；Redis 仅内网 / VPC 可达
    "TrustForwardedHeaders": true,
    "CredentialCacheSeconds": 60,
    "LocalFallbackEnabled": true,
    "FallbackRequeueIntervalSeconds": 30,
    "FallbackRequeueBatchSize": 100,
    "AutoTrimEnabled": false,
    "SafeTrimEnabled": true,
    "ProbeRedisOnStartup": true
  }
}
