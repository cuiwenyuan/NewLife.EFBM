{
  // 内网生产：MySQL 同实例分库，HTTP 由 Nginx 反代；密钥用环境变量或密钥管理覆盖，勿明文入库
  "ConnectionStrings": {
    "EFBM": "Server=127.0.0.1;Port=3306;Database=EFBM;Uid=efbm;Pwd=<替换为强密码>;Provider=MySql",
    "Membership": "Server=127.0.0.1;Port=3306;Database=Membership;Uid=efbm;Pwd=<替换为强密码>;Provider=MySql"
  },
  "EFBM": {
    "Deployment": "Intranet",
    "RequireHttps": false,
    "AuthMode": "AppKeyAppSecret",
    "RedisServer": "127.0.0.1:6379",
    "ProbeRedisOnStartup": true
  }
}
