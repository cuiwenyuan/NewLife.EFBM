{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "AllowedHosts": "*",

  // Kestrel 只监听本机，由 Nginx / IIS 反向代理对外；外网只暴露 443
  "Urls": "http://127.0.0.1:5000",

  "ConnectionStrings": {
    // 开发环境默认 SQLite；连接名 EFBM 对应 src/EFBM.Data/Model.xml 的 ConnName
    "EFBM": "Data Source=EFBM.db;Provider=SQLite",
    "Membership": "Data Source=Membership.db;Provider=SQLite",

    // 生产 MySQL 模板（见《部署文档.md》§2.3，账号与密码由部署环境提供）
    //"EFBM": "Server=127.0.0.1;Port=3306;Database=EFBM;Uid=efbm;Pwd=<强密码>;Provider=MySql",
    //"Membership": "Server=127.0.0.1;Port=3306;Database=Membership;Uid=efbm;Pwd=<强密码>;Provider=MySql",

    // 魔方审计日志与权限体系共用 Membership 连接
    "Log": "MapTo=Membership",
    "Cube": "MapTo=Membership"
  },

  "EFBM": {
    "Deployment": "Intranet",
    "RequireHttps": false,
    "AuthMode": "AppKeyAppSecret",
    "AppKeyHeader": "X-App-Key",
    "AppSecretHeader": "X-App-Secret",
    "StreamKey": "efbm:events",
    "PersistGroup": "efbm-persist",
    // 是否接入共享上报流。Beta 纯日志模式设为 false：不连 Redis，数据只进请求日志与本地兜底
    "RedisEnabled": true,
    "RedisServer": "127.0.0.1:6379",
    "RedisPassword": "",
    "RedisDb": 5,
    "BatchSize": 200,
    "BatchIntervalMs": 200,
    // 凭据进程内缓存秒数：稳态逐件上报不查库；后台发放 / 重置凭据时必须主动失效缓存
    "CredentialCacheSeconds": 60,
    // 反向代理可信时从 X-Forwarded-For / X-Real-IP / X-Forwarded-Proto 取来源 IP 与实际协议
    "TrustForwardedHeaders": true,
    // 单次上报请求体上限（4MB），仅防异常大包，正常报文远小于该值
    "MaxBodyBytes": 4194304,
    "LocalFallbackEnabled": true,
    // Redis 恢复后本地兜底回灌：每 30 秒最多 100 条，无待回灌记录时不连接 Redis
    "FallbackRequeueIntervalSeconds": 30,
    "FallbackRequeueBatchSize": 100,
    // 必须为 false：框架按长度 / 时间自动裁剪不判断消费组是否已消费，会静默删除未确认消息
    "AutoTrimEnabled": false,
    "SafeTrimEnabled": true,
    "ProbeRedisOnStartup": false,

    // 请求日志：每条上报一行 JSON 落到 logs/api/，是队列不可用时的最后一道兜底。
    // 目录为相对路径时以内容根目录为基准（不是进程工作目录）；生产建议改成绝对路径。
    "RequestLog": {
      "Enabled": true,
      "Directory": "logs/api",
      "FileNamePrefix": "api",
      // 单文件上限（MB），超过后同日切 -002 等序号文件
      "MaxFileMB": 64,
      // 保留天数，0 表示永不清理；只清理本目录本前缀的 *.log
      "RetentionDays": 90,
      // 是否记录请求体原文：关闭后无法离线补录，仅在报文含敏感数据时关闭
      "IncludeRaw": true,
      // 每条都 fsync 到磁盘（约 1ms/条），断电不丢；高并发可关闭
      "FlushToDisk": true
    },

    // Beta 引导：P4 后台发放页面未上线前，用配置补齐一台设备与一套凭据。
    // 默认关闭；只在 Development / 内网 Beta 打开，外网部署启用会启动失败。
    "Beta": {
      "Enabled": false,
      "DeviceId": "FBOX-A01",
      "DeviceName": "Beta 联调设备",
      "AppKey": "beta-fbox-a01",
      "AppSecret": "",
      "ResetSecret": false
    }
  }
}
