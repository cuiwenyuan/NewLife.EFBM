<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <AssemblyTitle>EFBM 上报 API 与管理后台</AssemblyTitle>
    <Description>电动折盒机主动上报的纯接收端：NewLife.Cube 宿主、RedisStream 共享流、XCode 持久化</Description>
    <!-- 版本基号（主.次）；发版时 tools/release.sh 自动按 NewLife 规则拼上 年.MDD（如 1.0.2026.1113 = 2026-11-13） -->
    <Version>1.0</Version>
    <UserSecretsId>efbm-web</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NewLife.Core" Version="12.0.2026.1024" />
    <PackageReference Include="NewLife.Cube.Core" Version="6.16.2026.1030" />
    <PackageReference Include="NewLife.Redis" Version="7.0.2026.1024" />
    <PackageReference Include="NewLife.Redis.Extensions" Version="7.0.2026.1024" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\EFBM.Core\EFBM.Core.csproj" />
    <ProjectReference Include="..\EFBM.Data\EFBM.Data.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- 运行时 XCode 配置：Migration=On、ShowSQL=false，必须随发布物一起输出 -->
    <None Include="Config\XCode.config" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
