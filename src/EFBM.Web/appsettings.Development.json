{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information",
      "EFBM": "Debug"
    }
  },
  "EFBM": {
    "Deployment": "Intranet",
    "AuthMode": "AppKeyAppSecret",

    // 本机默认纯日志模式：没有 Redis 也能收数据，请求原文落在 logs/api/api-yyyyMMdd.log。
    // 要验证「真正写入 Stream」，把它改成 true 并启动 Redis 即可。
    "RedisEnabled": false

    // 设备凭据在后台「接入凭据」页发放（登录 admin 后添加 AppKey / AppSecret 并绑定设备）。
  }
}
