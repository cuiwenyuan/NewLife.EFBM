{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information",
      "EFBM": "Debug"
    }
  },
  "EFBM": {
    "Deployment": "Intranet",
    "AuthMode": "AppKeyAppSecret",

    // Beta 默认纯日志模式：本机没有 Redis 也能收数据，请求原文落在 logs/api/api-yyyyMMdd.log。
    // 要验证「真正写入 Stream」，把它改成 true 并启动 Redis 即可。
    "RedisEnabled": false,

    // 开发环境自动准备一套可用凭据，省去手工写库；生产环境必须关闭
    "Beta": {
      "Enabled": true,
      "DeviceId": "FBOX-A01",
      "DeviceName": "开发机联调设备",
      "AppKey": "beta-fbox-a01",
      "AppSecret": "beta-secret-2026",
      "ResetSecret": true
    }
  }
}
