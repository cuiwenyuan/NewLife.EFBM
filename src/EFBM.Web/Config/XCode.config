<?xml version="1.0" encoding="utf-8"?>
<XCode>
  <!-- 调试开关 -->
  <Debug>false</Debug>
  <!-- 关闭 SQL 日志：逐件明细与原始报文量大，避免日志膨胀 -->
  <ShowSQL>false</ShowSQL>
  <!-- 迁移策略：On 只新建表 / 加列，不删列。字段固化时靠它自动加列，见需求说明 §3.7 -->
  <Migration>On</Migration>
  <!-- 迁移时检查表 / 字段注释与索引 -->
  <CheckComment>true</CheckComment>
  <CheckAddIndex>true</CheckAddIndex>
  <CheckDuplicateIndex>true</CheckDuplicateIndex>
  <CheckDeleteIndex>false</CheckDeleteIndex>
  <!-- 大小写：由数据库决定，保持模型命名 -->
  <NameFormat>Default</NameFormat>
  <!-- 批量大小与间隔：消费者攒批事务写参考此值 -->
  <BatchSize>5000</BatchSize>
  <BatchInterval>100</BatchInterval>
  <!-- 慢 SQL 阈值（毫秒） -->
  <TraceSQLTime>1000</TraceSQLTime>
  <SQLMaxLength>4096</SQLMaxLength>
  <!-- 参数化 CRUD：XCode 默认关闭 -->
  <UseParameter>false</UseParameter>
  <!-- 实体 / 单对象缓存：逐件明细不依赖缓存，保持默认值 -->
  <EntityCacheExpire>10</EntityCacheExpire>
  <SingleCacheExpire>10</SingleCacheExpire>
</XCode>
